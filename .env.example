DEEPGRAM_API_KEY=your_deepgram_key
OPENAI_API_KEY=your_openai_key
RATE_MODEL=gpt-6-sol
RATE_EFFORT=low
TONALITY_MODEL=gpt-6-sol
TONALITY_EFFORT=low
# Gemini also listens for pitch problems; without a key, pitch is measured only.
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash
# Tonality flags a passage when Gemini rates its voice this or lower (1 = flat, 2 = mostly flat, 3 = ordinary; 1-4)
TONALITY_FLAT_SCORE=2
# Requests in flight at once per API, shared by every review on the server
GEMINI_CONCURRENCY=8
OPENAI_CONCURRENCY=16
