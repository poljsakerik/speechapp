{
  "name": "@micmane/vocal-processing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./align": "./src/align.ts",
    "./deepgram": "./src/deepgram.ts",
    "./openai": "./src/openai.ts",
    "./pacing": "./src/pacing.ts",
    "./pause": "./src/pause.ts",
    "./pause-review": "./src/pause-review.ts",
    "./pauses": "./src/pauses.ts",
    "./rate": "./src/rate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "rate": "node --env-file-if-exists=../../.env scripts/rate.ts",
    "eval:rate": "node --env-file-if-exists=../../.env scripts/eval-rate.ts",
    "eval:pause": "node --env-file-if-exists=../../.env scripts/eval-pause.ts",
    "import:voice-pack": "node --env-file-if-exists=../../.env scripts/import-voice-pack.ts",
    "import:rate": "node --env-file-if-exists=../../.env scripts/import-rate-benchmark.ts",
    "import:pause": "node --env-file-if-exists=../../.env scripts/import-rate-benchmark.ts --recipe ../../benchmarks/pause-development.json"
  },
  "devDependencies": {
    "@micmane/eslint-config": "workspace:*",
    "@micmane/typescript-config": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cmu-pronouncing-dictionary": "^3.0.0",
    "onnxruntime-node": "^1.30.0"
  }
}
